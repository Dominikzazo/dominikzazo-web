# ── Členská sekcia (/clenska) ─────────────────────────────
# Skopíruj do .env.local a doplň reálne hodnoty. .env.local sa NEcommitne.

# Clerk (https://dashboard.clerk.com → tvoja app → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Kam vedú Clerk auth routes (nechaj tak, ak nemeníš cesty)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/clenska/obsah
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/clenska/obsah

# ── Krok 2 (webhook → welcome email + newsletter + Discord) ──────
# Clerk dashboard → Webhooks → endpoint /api/members/register-webhook → Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Resend (dominikzazo.sk brand — NIE bitcoinovaskola)
RESEND_API_KEY=re_xxx
# Odosielateľ musí byť na doméne verifikovanej v Resende (dominikzazo.sk)
MEMBERS_FROM_EMAIL=Dominik Žažo <ahoj@dominikzazo.sk>
MEMBERS_SITE_URL=https://dominikzazo.sk
# Newsletter list (Resend → Audiences → ID). Prázdne = preskočí pridanie kontaktu.
RESEND_AUDIENCE_ID=
# Discord webhook (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
